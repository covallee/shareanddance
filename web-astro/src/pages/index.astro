---
import Layout from "../layouts/Layout.astro"
import Header from "../components/Header.astro"
import Cards from "../components/Cards.astro"
import { getTracks, getSiteSettings } from "../lib/sanity"

const tracks = await getTracks()
const settings = await getSiteSettings()
---

<Layout title="Home" keywords={["music", "spotify", "tracks"]}>
  <Header siteTitle={settings.title} />
  <div class="container">
    <main>
      <h1>Just some tracks that I like</h1>
      <Cards tracks={tracks} />
    </main>
  </div>
  <footer>
    <div class="footer-content">
      © {new Date().getFullYear()}, Built with 💜,
      <a href="https://astro.build">Astro</a>,
      <a href="https://www.netlify.com/">Netlify</a>, and <a
        href="https://www.sanity.io">Sanity</a
      >
    </div>
  </footer>
</Layout>

<style>
  .container {
    margin: 0 auto;
    max-width: 960px;
    padding: 0 1.0875rem 1.45rem;
    padding-top: 0;
  }

  h1 {
    font-size: 1rem;
  }

  .footer-content {
    margin: 0 auto;
    max-width: 960px;
    padding: 1.45rem 1.0875rem;
  }
</style>
